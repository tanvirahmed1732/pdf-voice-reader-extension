{
  "manifest_version": 3,
  "name": "PDF Voice Reader",
  "version": "0.1.0",
  "description": "Open PDFs in a reader tab and listen with system or downloadable neural voices, with live word highlighting.",
  "minimum_chrome_version": "124",
  "action": {
    "default_title": "PDF Voice Reader (toggle side panel)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "offscreen",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
